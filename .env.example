# Skopiuj ten plik jako .env i uzupełnij.

# Token bota z https://discord.com/developers/applications → twoja aplikacja → Bot → Reset Token
DISCORD_TOKEN=wklej_tutaj_token

# 1 = bot pamięta ostatnie 50 wiadomości z każdego kanału (tylko w RAM) i odtwarza je po odbudowie kanału.
#     Wymaga włączenia MESSAGE CONTENT INTENT w Developer Portal.
# 0 = wyłączone.
ODTWARZAJ_WIADOMOSCI=1

# Opcjonalnie: ID twojego serwera – komendy pojawią się na nim od razu (przy testach).
SERWER_ID=
